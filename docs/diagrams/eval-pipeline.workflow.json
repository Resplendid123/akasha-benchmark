{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Akasha-Benchmark 评测管线",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "docs/diagrams/eval-pipeline.html"
  },
  "lanes": [
    { "id": "online", "label": "在线 · Akasha HTTP" },
    { "id": "local", "label": "本地 · 产物与指标" },
    { "id": "optional", "label": "可选 · 审计表归因" },
    { "id": "stopped", "label": "闸门未过 · 停止", "variant": "exception" }
  ],
  "phases": [
    { "id": "load", "label": "入库", "fromCol": 0, "toCol": 2, "variant": "emphasis" },
    { "id": "ask", "label": "查询", "fromCol": 3, "toCol": 4 },
    { "id": "score", "label": "评测", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "groups": [
    { "id": "gates", "label": "两道不可跳过的闸门", "lane": "online", "fromCol": 0, "toCol": 3, "variant": "security" }
  ],
  "mainPath": ["owner", "import", "compile", "quality", "query", "responses", "evaluate"],
  "nodes": [
    { "id": "subset", "lane": "local", "col": 0, "type": "database", "label": "子集语料", "sublabel": "corpus/{doc_id}.md", "tag": "导入前重算 sha256", "width": 128 },
    { "id": "owner", "lane": "online", "col": 0, "type": "security", "label": "登录并校验 OWNER", "sublabel": "POST /api/auth/login", "tag": "非 OWNER 直接终止", "width": 128 },
    { "id": "import", "lane": "online", "col": 1, "type": "cloud", "label": "串行导入", "sublabel": "每组一个独立 Space", "tag": "并发 1 · 可续跑", "width": 128 },
    { "id": "compile", "lane": "online", "col": 2, "type": "cloud", "label": "编译并轮询", "sublabel": "compile-spaces", "tag": "绕过 1 小时静默期", "width": 128 },
    { "id": "quality", "lane": "online", "col": 3, "type": "security", "label": "入库质量闸门", "sublabel": "missing / stale 四项计数", "tag": "缺字段也算失败", "width": 128 },
    { "id": "query", "lane": "online", "col": 4, "type": "cloud", "label": "逐条跑 query", "sublabel": "并发 1 · 不算任何指标", "tag": "先比对模型配置快照", "width": 128 },
    { "id": "stop", "lane": "stopped", "col": 4, "type": "security", "label": "不进入查询", "sublabel": "非零退出", "tag": "retry-pages 后重跑", "width": 128 },
    { "id": "responses", "lane": "local", "col": 4, "type": "database", "label": "响应落盘", "sublabel": "存完整响应体", "tag": "失败行照样写一行", "width": 128 },
    { "id": "evaluate", "lane": "local", "col": 5, "type": "backend", "label": "离线算指标出报告", "sublabel": "检索 · 答案 · 引用 · 多跳", "tag": "metrics.json + report.md", "width": 128 },
    { "id": "audit", "lane": "optional", "col": 5, "type": "database", "label": "三段损失归因", "sublabel": "读 per_sample + 审计表", "tag": "按 retrievalMode 切分", "width": 128 }
  ],
  "edges": [
    { "id": "corpus-in", "from": "subset", "to": "import", "label": "语料 md", "variant": "default" },
    { "id": "role-ok", "from": "owner", "to": "import", "label": "role == owner", "variant": "security" },
    { "id": "imported", "from": "import", "to": "compile", "label": "page_map.jsonl", "variant": "emphasis" },
    { "id": "terminal", "from": "compile", "to": "quality", "label": "全部终态", "variant": "emphasis" },
    { "id": "gate-pass", "from": "quality", "to": "query", "label": "四项全为 0", "variant": "emphasis" },
    { "id": "gate-fail", "from": "quality", "to": "stop", "label": "任一非 0", "variant": "security", "role": "error" },
    { "id": "persist", "from": "query", "to": "responses", "label": "逐条 flush", "variant": "emphasis" },
    { "id": "score", "from": "responses", "to": "evaluate", "label": "读响应 + page_map", "variant": "emphasis" },
    { "id": "attribute", "from": "evaluate", "to": "audit", "variant": "dashed", "role": "branch" }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "两道闸门都不能跳过",
      "items": [
        "评测用户必须是 OWNER：否则 chunk 在第三道授权闸门被静默丢弃，症状看起来像召回质量差。",
        "质量报告四项计数必须全为 0，字段是 camelCase —— 取不到值时每项都是 None，闸门会假通过。",
        "闸门没过就跑查询，等于拿一个半成品索引烧一遍 LLM 调用，指标全部无意义。"
      ]
    },
    {
      "dot": "emerald",
      "title": "可续跑，且身份不会串",
      "items": [
        "入库续跑的键是 (dataset, doc_id)：裸 doc_id 跨组会撞 60 个，只按它建字典会漏导整批。",
        "查询按已有 sample_id 跳过，包括失败行；响应存完整响应体，想看新字段不必重烧 LLM。",
        "page_map 负责把响应里的 sourcePageId 反查回语料文档，评测的检索指标全靠它。"
      ]
    },
    {
      "dot": "amber",
      "title": "读指标时的两条边界",
      "items": [
        "no_match 与 general 无条件返回空 retrievedSources，所以每张检索表都出全样本与 knowledge 两份。",
        "retrievalDiagnostics 不在 HTTP 响应里，三段损失只能走审计表，连接键带 sha256: 前缀。",
        "NarrativeQA 没有 gold，检索类指标一律省略并写明原因，不伪造 0 分污染汇总。"
      ]
    }
  ]
}
