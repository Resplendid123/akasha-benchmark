    { "label": "归一化" },
    { "label": "底座与验收" },
    { "label": "抽样" },
    { "label": "子集产物" }
  ],
  "nodes": [
    { "id": "raw", "type": "database", "label": "四组原始 JSON", "sublabel": "osunlp/HippoRAG_2", "tag": "dataset/ · 约 137MB", "stage": 0, "row": 1, "width": 132, "brand": "hugging-face" },
    { "id": "normalize", "type": "backend", "label": "归一化全量", "sublabel": "显式适配器按名分派", "tag": "gold 去重成集合", "stage": 1, "row": 1, "width": 132 },
    { "id": "normalized", "type": "database", "label": "归一化底座", "sublabel": "samples + corpus", "tag": "全量，不抽样", "stage": 2, "row": 0, "width": 132 },
    { "id": "validate", "type": "security", "label": "逐行验收", "sublabel": "validate_datasets.py", "tag": "四组须全过", "stage": 2, "row": 1, "width": 132 },
    { "id": "subset", "type": "backend", "label": "抽子集", "sublabel": "先 QA 后 corpus", "tag": "固定种子 · 覆盖率 1.0", "stage": 3, "row": 0, "width": 132 },
    { "id": "narrative", "type": "backend", "label": "NarrativeQA 分支", "sublabel": "整篇取文档", "tag": "不参与检索指标", "stage": 3, "row": 2, "width": 132 },
    { "id": "out", "type": "database", "label": "子集产物", "sublabel": "corpus/{doc_id}.md", "tag": "manifest 记种子与哈希", "stage": 4, "row": 1, "width": 132 }
  ],
  "flows": [
    { "id": "feed-adapters", "from": "raw", "to": "normalize", "label": "逐行过适配器", "classification": "全量", "variant": "emphasis", "route": "straight" },
    { "id": "write-base", "from": "normalize", "to": "normalized", "label": "原子写入", "variant": "emphasis" },
    { "id": "rederive", "from": "normalize", "to": "validate", "label": "重新推导比对", "variant": "security", "route": "straight", "labelDy": 26 },
    { "id": "read-base", "from": "normalized", "to": "subset", "label": "读底座", "variant": "emphasis", "route": "straight" },
    { "id": "gate-pass", "from": "validate", "to": "subset", "label": "全过才抽样", "variant": "security", "channelX": 623 },
    { "id": "no-gold", "from": "validate", "to": "narrative", "label": "无 gold", "variant": "dashed", "channelX": 662 },
    { "id": "to-markdown", "from": "subset", "to": "out", "label": "写成 md", "variant": "emphasis" },
    { "id": "chunks-kept", "from": "narrative", "to": "out", "label": "全部 chunk", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "抽样顺序不能颠倒",
      "items": [
        "先抽 100 条 QA，再把它们的 gold doc_id 全集设为 corpus 必选，最后补等量负样本。",
        "反过来随机抽 corpus，gold 会大量落在子集外，Recall 被钉在 0 附近 —— 与检索器无关。",
        "MuSiQue 按 hop_prefix 六层分名额，最大余额法保留 4hop2 这类只占 2.7% 的小层。"
      ]
    },
    {
      "dot": "cyan",
      "title": "身份收在一处，不推断",
      "items": [
        "doc_id 用原生 idx；2wiki 与 MuSiQue 没有 idx，用 corpus 行号，口径收在 CORPUS_ID_RULES。",
        "MuSiQue 的对齐键是 (title, text) 而非 title：2465 行落在重复 title 组里，仍重复则报错。",
        "md 文件名用 doc_id，首个 heading 负责 title —— 两者独立，title 重复也不影响身份追踪。"
      ]
    },
    {
      "dot": "amber",
      "title": "corpus 不去重",
      "items": [
        "MuSiQue 的重复 title 是不同段落，去重会丢 gold；去重前后条数都记进 manifest。",
        "gold 必须去重成集合，否则 Recall 分母是错的 —— hotpotqa 的标注是 (title, 句下标) 对。",
        "validate 复核源文件哈希，能发现「归一化之后源数据被改过」这类静默漂移。"
      ]
    }
  ]
}
