  "cards": [
    {
      "dot": "cyan",
      "title": "抽样与指标口径",
      "items": [
        "HotpotQA / 2Wiki / MuSiQue：先选 QA，再保留全部 gold 并补负样本。",
        "NarrativeQA：按整篇文档取子集；无 gold，省略检索相关指标。"
      ]
    },
    {
      "dot": "emerald",
      "title": "可恢复与可追溯",
      "items": [
        "导入、查询支持续跑；page_map.jsonl 将 page_id 反查为 doc_id。",
        "离线评测核对 sample_id 与 question；审计另需 psycopg 和数据库配置。"
      ]
    },
    {
      "dot": "amber",
      "title": "结果解释边界",
      "items": [
        "召回基于编译生成文本；分列全样本与 knowledge 回答的检索指标。",
        "五轮需依次执行；本图依据当前代码，不包含计划中的第六轮原文基线。"
      ]
    }
  ]
